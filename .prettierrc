{
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 100,
  "semi": true,
  "arrowParens": "always",
  "bracketSpacing": true,
  "bracketSameLine": false,
  "proseWrap": "preserve",
  "endOfLine": "lf",
  "htmlWhitespaceSensitivity": "css",
  "insertPragma": false,
  "requirePragma": false,
  "embeddedLanguageFormatting": "auto",
  "tabWidth": 2,
  "useTabs": false,
  "overrides": [
    {
      "files": ["*.json", "*.json5"],
      "options": {
        "parser": "json",
        "tabWidth": 2
      }
    },
    {
      "files": ["*.md", "*.mdx"],
      "options": {
        "proseWrap": "always",
        "printWidth": 100
      }
    },
    {
      "files": ["*.yml", "*.yaml"],
      "options": {
        "tabWidth": 2
      }
    },
    {
      "files": ["*.graphql", "*.gql"],
      "options": {
        "tabWidth": 2
      }
    },
    {
      "files": ["package.json", "lerna.json", "pnpm-workspace.yaml"],
      "options": {
        "tabWidth": 2,
        "printWidth": 100
      }
    }
  ]
}
